# Database
DATABASE_URL="postgresql://username:password@localhost:5432/systematic_web?schema=public"

# JWT — IMPORTANT: Change this to a strong random secret in production!
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="CHANGE-ME-to-a-strong-random-secret-in-production"
JWT_EXPIRATION="24h"

# App
PORT=3001
NODE_ENV=production

# CORS — Set to your frontend URL
CORS_ORIGIN=http://localhost:3000
