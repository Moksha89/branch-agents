generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  EMPLOYEE
  VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id           String        @id @default(uuid())
  username     String        @unique
  password     String
  fullName     String        @map("full_name")
  email        String?       @unique
  phone        String?
  role         UserRole      @default(EMPLOYEE)
  status       UserStatus    @default(ACTIVE)
  avatar           String?
  telegramChatId   String?       @map("telegram_chat_id")
  lastLogin        DateTime?     @map("last_login")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  bankAccounts    BankAccount[]
  transactions    Transaction[]
  dailyReports    DailyReport[]
  branchAccess    BranchAccess[]
  expenses        Expense[]

  @@map("users")
}

model Branch {
  id           String        @id @default(uuid())
  name         String        @unique
  code         String        @unique
  address      String?
  city         String?
  state        String?
  pincode      String?
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  bankAccounts   BankAccount[]
  dailyReports   DailyReport[]
  branchAccess   BranchAccess[]
  expenses       Expense[]

  @@map("branches")
}

model BankAccount {
  id                  String        @id @default(uuid())
  fullName            String        @map("full_name")
  mobileNumber        String        @map("mobile_number")
  aadharLinkedNumber  String        @map("aadhar_linked_number")
  bankName            String        @map("bank_name")
  accountNumber       String        @map("account_number")
  ifscCode            String        @map("ifsc_code")
  bankBranch          String        @map("bank_branch")
  aadharNumber        String        @map("aadhar_number")
  aadharPhoto         String?       @map("aadhar_photo")
  aadharPhotoBack     String?       @map("aadhar_photo_back")
  panCardNumber       String        @map("pan_card_number")
  panCardPhoto        String?       @map("pan_card_photo")
  panCardPhotoBack    String?       @map("pan_card_photo_back")
  debitCardNumber     String        @map("debit_card_number")
  debitCardExpiry     String        @map("debit_card_expiry")
  debitCardCvv        String        @map("debit_card_cvv")
  debitCardPhoto      String?       @map("debit_card_photo")
  debitCardPhotoBack  String?       @map("debit_card_photo_back")
  netbankingUsername  String        @map("netbanking_username")
  netbankingPassword  String        @map("netbanking_password")
  bankBalance         Decimal       @default(0) @map("bank_balance") @db.Decimal(15, 2)
  status              AccountStatus @default(ACTIVE)
  branchId            String        @map("branch_id")
  branch              Branch        @relation(fields: [branchId], references: [id])
  createdById         String        @map("created_by_id")
  createdBy           User          @relation(fields: [createdById], references: [id])
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  transactionsFrom    Transaction[] @relation("FromAccount")
  transactionsTo      Transaction[] @relation("ToAccount")
  merchants           Merchant[]
  documents           Document[]
  expenses            Expense[]

  @@index([branchId])
  @@index([createdById])
  @@index([status])
  @@map("bank_accounts")
}

model Merchant {
  id              String      @id @default(uuid())
  name            String
  type            String      // e.g. "PhonePe", "Google Pay", "Paytm", "Other"
  merchantId      String?     @map("merchant_id")
  mobileNumber    String?     @map("mobile_number")
  balance         Decimal     @default(0) @db.Decimal(15, 2)
  qrCodePhoto     String?     @map("qr_code_photo")
  bankAccountId   String      @map("bank_account_id")
  bankAccount     BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@index([bankAccountId])
  @@map("merchants")
}

model Document {
  id              String      @id @default(uuid())
  name            String
  type            String      // e.g. "ID Proof", "Address Proof", "Bank Statement", "Other"
  filePath        String      @map("file_path")
  fileSize        Int?        @map("file_size")
  mimeType        String?     @map("mime_type")
  bankAccountId   String      @map("bank_account_id")
  bankAccount     BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  uploadedAt      DateTime    @default(now()) @map("uploaded_at")

  @@index([bankAccountId])
  @@map("documents")
}

enum AccessLevel {
  READ
  WRITE
  FULL
}

model BranchAccess {
  id          String      @id @default(uuid())
  userId      String      @map("user_id")
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId    String      @map("branch_id")
  branch      Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  accessLevel AccessLevel @default(READ) @map("access_level")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@unique([userId, branchId])
  @@index([userId])
  @@index([branchId])
  @@map("branch_access")
}

enum AccountStatus {
  ACTIVE
  DEBIT_FREEZE
  CREDIT_FREEZE
  CYBER
  CLOSED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
  OUT_TRANSFER
  IN_TRANSFER
}

model Transaction {
  id                    String          @id @default(uuid())
  type                  TransactionType
  amount                Decimal       @db.Decimal(15, 2)
  balanceBefore         Decimal       @map("balance_before") @db.Decimal(15, 2)
  balanceAfter          Decimal       @map("balance_after") @db.Decimal(15, 2)
  description           String?
  fromAccountId         String          @map("from_account_id")
  fromAccount           BankAccount     @relation("FromAccount", fields: [fromAccountId], references: [id], onDelete: Cascade)
  toAccountId           String?         @map("to_account_id")
  toAccount             BankAccount?    @relation("ToAccount", fields: [toAccountId], references: [id], onDelete: SetNull)
  createdById           String          @map("created_by_id")
  createdBy             User            @relation(fields: [createdById], references: [id])
  isReversal            Boolean         @default(false) @map("is_reversal")
  reversedTransactionId String?         @map("reversed_transaction_id")
  createdAt             DateTime        @default(now()) @map("created_at")

  @@index([fromAccountId])
  @@index([toAccountId])
  @@index([createdAt])
  @@index([type])
  @@map("transactions")
}

model DailyReport {
  id              String   @id @default(uuid())
  date            DateTime @db.Date
  totalDeposit    Decimal  @map("total_deposit") @db.Decimal(15, 2)
  totalWithdrawal Decimal  @map("total_withdrawal") @db.Decimal(15, 2)
  playerBalance   Decimal  @map("player_balance") @db.Decimal(15, 2)
  profitLoss      Decimal  @map("profit_loss") @db.Decimal(15, 2)
  branchId        String   @map("branch_id")
  branch          Branch   @relation(fields: [branchId], references: [id])
  createdById     String   @map("created_by_id")
  createdBy       User     @relation(fields: [createdById], references: [id])
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([branchId])
  @@index([createdById])
  @@unique([branchId, date])
  @@map("daily_reports")
}

model Expense {
  id              String      @id @default(uuid())
  amount          Decimal     @db.Decimal(15, 2)
  reason          String
  balanceBefore   Decimal     @map("balance_before") @db.Decimal(15, 2)
  balanceAfter    Decimal     @map("balance_after") @db.Decimal(15, 2)
  accountId       String      @map("account_id")
  account         BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  branchId        String      @map("branch_id")
  branch          Branch      @relation(fields: [branchId], references: [id])
  createdById     String      @map("created_by_id")
  createdBy       User        @relation(fields: [createdById], references: [id])
  createdAt       DateTime    @default(now()) @map("created_at")

  @@index([accountId])
  @@index([branchId])
  @@index([createdById])
  @@index([createdAt])
  @@map("expenses")
}

model Otp {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  code        String
  expiresAt   DateTime @map("expires_at")
  used        Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("otps")
}

model TelegramLinkCode {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  code        String   @unique
  expiresAt   DateTime @map("expires_at")
  used        Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([code])
  @@map("telegram_link_codes")
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String   // e.g. CREATE_BRANCH, UPDATE_ACCOUNT, DELETE_USER, LOGIN, TRANSFER_ACCOUNT
  entity      String?  // e.g. "branch", "account", "user", "transaction", "expense"
  entityId    String?  @map("entity_id")
  details     String?  @db.Text // JSON stringified details
  ipAddress   String?  @map("ip_address")
  userId      String?  @map("user_id")
  userName    String?  @map("user_name")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([entity])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model UserSession {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  token       String   @unique
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  isActive    Boolean  @default(true) @map("is_active")
  lastActivity DateTime @default(now()) @map("last_activity")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([token])
  @@index([isActive])
  @@map("user_sessions")
}

model Notification {
  id          String   @id @default(uuid())
  title       String
  message     String
  type        String   @default("info") // info, success, warning, error
  entity      String?  // e.g. "transaction", "account", "branch"
  entityId    String?  @map("entity_id")
  userId      String?  @map("user_id") // null means broadcast to all
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model ScheduledReport {
  id          String   @id @default(uuid())
  name        String
  frequency   String   // "daily", "weekly", "monthly"
  dayOfWeek   Int?     @map("day_of_week") // 0-6 for weekly
  dayOfMonth  Int?     @map("day_of_month") // 1-31 for monthly
  time        String   @default("09:00") // HH:mm
  branchIds   String?  @map("branch_ids") // comma-separated branch IDs, null = all
  isActive    Boolean  @default(true) @map("is_active")
  lastRun     DateTime? @map("last_run")
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("scheduled_reports")
}

model LoginAttempt {
  id          String   @id @default(uuid())
  username    String
  ipAddress   String?  @map("ip_address")
  success     Boolean
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([username])
  @@index([ipAddress])
  @@index([createdAt])
  @@map("login_attempts")
}
